# Copy to .env and fill in before `docker compose up`.

FLASK_ENV=production
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

MONGO_URI=mongodb://mongo:27017/
MONGO_DBNAME=key_and_kin

# Admin login for /admin. Generate the hash with:
#   docker compose run --rm web flask hash-password
# Escape every "$" in the hash as "$$" so docker compose doesn't interpolate it.
ADMIN_EMAIL=owner@keyandkin.lan
ADMIN_PASSWORD_HASH=

# Flip both to true only once a TLS-terminating reverse proxy sits in front.
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

INQUIRY_RATE_LIMIT=5
